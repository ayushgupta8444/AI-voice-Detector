# =============================================================================
# VoiceShield AI — Environment Configuration
# Information and Network Security (INS) Expo
# =============================================================================

# Application Settings
APP_NAME="VoiceShield AI"
APP_ENV=development
DEBUG=True
API_PREFIX=/api

# Database Configuration
# Default: Local SQLite database (Zero external dependency required for local expo demo)
DATABASE_URL=sqlite:///./voiceshield.db

# Cloud PostgreSQL / Supabase (Optional for cloud production)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_KEY=[YOUR-SUPABASE-ANON-KEY]
# SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]

# Security & Authentication
JWT_SECRET_KEY=voiceshield-cybersecurity-expo-secret-key-2026-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload & Audio Processing Limits
MAX_AUDIO_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=600

# Speech Recognition Configuration
TRANSCRIPTION_PROVIDER=faster-whisper
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Voice Authenticity Analysis
ENABLE_AUDIO_AUTHENTICITY=True
AUTHENTICITY_MODEL_NAME=VoiceShield-Acoustic-Forensics-v1.0

# Privacy & Storage Settings
AUDIO_RETENTION_DEFAULT=False
AUDIO_STORAGE_PATH=./storage/audio

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Official Helplines (India)
INDIAN_CYBERCRIME_PORTAL_URL=https://cybercrime.gov.in
INDIAN_CYBERCRIME_HELPLINE=1930
CHAKSHU_PORTAL_URL=https://sancharsaathi.gov.in/sfc/
